# ============================================================
# 闲鱼自动回复系统 环境变量示例
# 用法：cp .env.example .env  然后填入真实值，务必 chmod 600 .env
# 本文件只含占位/默认值，不含任何真实凭证；真实 .env 已被 .gitignore 忽略。
# ============================================================

# ---------- 数据库（MySQL）----------
# 建议用官方镜像，别用来路不明的私仓镜像
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=xianyu_data
MYSQL_USER=xianyu
# 强随机密码：openssl rand -hex 24
MYSQL_PASSWORD=CHANGE_ME_openssl_rand_hex_24
MYSQL_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---------- 缓存（Redis）----------
REDIS_IMAGE=redis:7-alpine
REDIS_DB=0
# 强随机密码：openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---------- 服务端口 ----------
# 安全基线：仅 frontend 对外，后端三服务不映射宿主端口（见 docker-compose.override.yml）
FRONTEND_PORT=9000
BACKEND_WEB_PORT=8089
WEBSOCKET_PORT=8090
SCHEDULER_PORT=8091

# ---------- 外部 API 鉴权 ----------
# 供外部系统调用本项目 /send 等接口的密钥，务必改成强随机：openssl rand -hex 16
EXTERNAL_API_KEY=CHANGE_ME_openssl_rand_hex_16

# /send 消息发送接口(message.py)鉴权密钥。安全修复后此接口只认此环境变量、
# 未配置则一律拒绝(fail-closed)，无兜底默认值。务必改成强随机：openssl rand -hex 32
# 注意：backend-web 用显式 environment 注入，新增此变量需在 docker-compose.override.yml
# 的 backend-web.environment 加一行 - MESSAGE_API_SECRET=${MESSAGE_API_SECRET:-} 才会进容器。
MESSAGE_API_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---------- 远程回连开关（安全基线：全部关闭，先内测人工可控）----------
ENABLE_REMOTE_ADS=false
ENABLE_REMOTE_ANNOUNCEMENTS=false
ENABLE_REMOTE_POPUP_ANNOUNCEMENTS=false

# ---------- 自动启动开关（安全基线：关闭，人工点启动）----------
AUTO_START_WEBSOCKET=false
AUTO_START_CRAWL_JOBS=false

# ---------- 过滑块（captcha）----------
# DrissionPage 兜底引擎：Docker/Linux headless 可用
CAPTCHA_DRISSIONPAGE_FALLBACK_ENABLED=true
CAPTCHA_DRISSIONPAGE_HEADLESS=true
# 单次验证超时（秒）。默认 25 偏紧，实盘接近临界，建议 40~45
CAPTCHA_DRISSIONPAGE_TIMEOUT=45
# 同时过滑块的最大并发数
MAX_CAPTCHA_CONCURRENT=3

# ---------- 日志 ----------
LOG_LEVEL=INFO
SQL_ECHO=false

# ---------- Token / 会话有效期 ----------
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080
TOKEN_CACHE_TTL_MIN_HOURS=6
TOKEN_CACHE_TTL_MAX_HOURS=12

# ---------- 定时任务间隔 ----------
RATE_INTERVAL=3600
REDELIVERY_INTERVAL=3600

# ---------- 上游/远程官方地址（默认为上游值，通常无需改）----------
# CARD_DOCK_BASE_URL=
# REMOTE_OFFICIAL_BASE_URL=
# BACKEND_WEB_PUBLIC_URL=
# FRONTEND_PUBLIC_URL=
